{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sugar Archive",
  "version": "0.1.0",
  "identifier": "com.sugararchive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sugar Archive",
        "width": 1080,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "zip",
          "7z",
          "rar",
          "tar",
          "tgz",
          "tbz",
          "tbz2",
          "txz",
          "gz",
          "bz2",
          "xz"
        ],
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
